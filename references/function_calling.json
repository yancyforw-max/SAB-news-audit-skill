          },
          "column_type": {
            "type": "string",
            "description": "稿件所属星系列栏目。",
            "enum": ["星动态", "星故事", "星分享", "星标杆", "星视频"]
          }
        },
        "required": ["article_text", "column_type"],
        "additionalProperties": false
      }
    }
  }
