    "type": "function",
    "function": {
      "name": "review_news_article",
      "description": "依据《SAB星系列新闻稿统一标准手册》，按指定栏目审核新闻稿，仅返回明确存在的问题、标准依据和修改建议，不生成Word或Excel文件。",
      "parameters": {
        "type": "object",
        "properties": {
          "article_text": {
            "type": "string",
